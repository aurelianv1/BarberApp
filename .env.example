# Client (public values, bundled into the web app). Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web push public key (public by design). Generate the pair with `npm run vapid:generate`.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Server-side secrets are NOT stored here: see supabase/functions/.env.example.
