# Client (public values, bundled into the web app). Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side secrets are NOT stored in this file. Set them with `supabase secrets set`:
#   CRON_SECRET        shared secret that pg_cron sends to the send-reminders function
#   VAPID_PUBLIC_KEY   web push public key
#   VAPID_PRIVATE_KEY  web push private key
#   VAPID_SUBJECT      mailto: address for web push
