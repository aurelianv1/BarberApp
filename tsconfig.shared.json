{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "supabase/functions/_shared/slots.ts",
    "supabase/functions/_shared/booking-rules.ts",
    "supabase/functions/_shared/webpush.ts",
    "supabase/functions/_shared/texts.ts",
    "supabase/functions/_shared/*.test.ts",
    "supabase/tests/**/*.ts",
    "scripts/*.ts"
  ]
}
