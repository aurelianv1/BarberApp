# Secrets for Edge Functions. Locally: copy to supabase/functions/.env.
# In production set them with `npx supabase secrets set NAME=value` (never commit real values).

# Shared secret pg_cron sends to send-reminders; must equal the `cron_secret` Vault secret.
CRON_SECRET=

# Web push keys, generated with `npm run vapid:generate`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
