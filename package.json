{
  "name": "barberapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "deno": "^2.9.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "http_ece": "^1.2.1",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.shared.json && npm run typecheck:functions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "vitest run --config vitest.db.config.mts",
    "typecheck:functions": "DENO_NO_PACKAGE_JSON=1 deno check --no-config supabase/functions/*/index.ts",
    "vapid:generate": "DENO_NO_PACKAGE_JSON=1 deno run --no-config scripts/generate-vapid-keys.ts"
  },
  "private": true
}
